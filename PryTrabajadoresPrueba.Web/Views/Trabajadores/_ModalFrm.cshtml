@model PryTrabajadoresPrueba.Application.DTOs.TrabajadorDTO

<form id="frmTrabajador" enctype="multipart/form-data">

    <input type="hidden" asp-for="IdTrb" />
    <input type="hidden" asp-for="FotoUrl" />

    <div class="container">

        <!-- Nombres -->
        <div class="row mb-3">
            <label asp-for="Nombres" class="col-md-4 col-form-label">Nombres :</label>
            <div class="col-md-8">
                <input asp-for="Nombres" class="form-control" />
                <span asp-validation-for="Nombres" class="text-danger small"></span>
            </div>
        </div>

        <!-- Apellidos -->
        <div class="row mb-3">
            <label asp-for="Apellidos" class="col-md-4 col-form-label">Apellidos :</label>
            <div class="col-md-8">
                <input asp-for="Apellidos" class="form-control" />
                <span asp-validation-for="Apellidos" class="text-danger small"></span>
            </div>
        </div>

        <!-- Tipo Documento -->
        <div class="row mb-3">
            <label asp-for="TipoDocumento" class="col-md-4 col-form-label">Tipo Documento :</label>
            <div class="col-md-8">
                <select asp-for="TipoDocumento" class="form-select" asp-items="ViewBag.ListaTipoDocumento">
                    <option value="">Seleccione...</option>
                </select>
            </div>
        </div>

        <!-- Nro Documento -->
        <div class="row mb-3">
            <label asp-for="NumeroDocumento" class="col-md-4 col-form-label">Nro Documento :</label>
            <div class="col-md-8">
                <input asp-for="NumeroDocumento" class="form-control" />
            </div>
        </div>

        <!-- Sexo -->
        <div class="row mb-3">
            <label asp-for="Sexo" class="col-md-4 col-form-label">Sexo :</label>
            <div class="col-md-8">
                <select asp-for="Sexo" class="form-select" asp-items="ViewBag.ListaSexo">
                    <option value="">Seleccione...</option>
                </select>
            </div>
        </div>

        <!-- Fecha -->
        <div class="row mb-3">
            <label asp-for="FechaNacimiento" class="col-md-4 col-form-label">Fecha Nac :</label>
            <div class="col-md-8">
                <input asp-for="FechaNacimiento" type="date" class="form-control" />
            </div>
        </div>

        <!-- Foto -->
        <div class="row mb-3">
            <label class="col-md-4 col-form-label">Foto :</label>
            <div class="col-md-8">
                <input type="file" name="fotoArchivo" class="form-control" accept="image/*" />

                @if (!string.IsNullOrEmpty(Model.FotoUrl))
                {
                    <div class="mt-2">
                        <img src="@Model.FotoUrl" height="50" class="rounded border" />
                    </div>
                }
            </div>
        </div>

        <!-- Dirección -->
        <div class="row mb-3">
            <label asp-for="Direccion" class="col-md-4 col-form-label">Dirección :</label>
            <div class="col-md-8">
                <textarea asp-for="Direccion" class="form-control" rows="2"></textarea>
            </div>
        </div>



        <!-- Botones -->
        <div class="text-center mt-4">
            <button type="button" class="btn btn-secondary me-3" data-bs-dismiss="modal">
                Cancelar
            </button>

            <button type="button" class="btn btn-primary" onclick="guardar()">
                Guardar
            </button>
        </div>

    </div>
</form>


<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>